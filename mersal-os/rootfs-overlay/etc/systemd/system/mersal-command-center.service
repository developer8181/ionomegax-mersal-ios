[Unit]
Description=Mersal Command Center (Ionomegax)
After=network.target

[Service]
Type=simple
Environment=MERSAL_HOST=0.0.0.0
Environment=MERSAL_PORT=8090
Environment=MERSAL_DB=/var/lib/mersal-guard/mersal-guard.sqlite3
WorkingDirectory=/opt/mersal-guard
ExecStart=/usr/bin/python3 /opt/mersal-guard/app.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
