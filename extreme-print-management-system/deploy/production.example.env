# Extreme Print Management System — production environment
EPMS_PRODUCTION=1
EPMS_HOST=0.0.0.0
EPMS_SEED_DEMO=0
EPMS_PORT=8080
EPMS_DB=/var/lib/epms/extreme-print-management.sqlite3
EPMS_SESSION_SECRET=replace-with-long-random-secret
EPMS_REQUIRE_AUTH=true
EPMS_AGENT_TOKEN=replace-with-agent-token
EPMS_BOOTSTRAP_ADMIN_PASSWORD=replace-on-first-boot
EPMS_ANONYMIZE_DOCS=true
EPMS_AUDIT_RETENTION_DAYS=365
# EPMS_TLS_CERT=/etc/epms/tls/fullchain.pem
# EPMS_TLS_KEY=/etc/epms/tls/privkey.pem
# EPMS_PG_DSN=postgresql://epms:secret@postgres:5432/epms
