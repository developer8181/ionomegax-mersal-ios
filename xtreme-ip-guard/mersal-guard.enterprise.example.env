# Mersal Guard v8.5 — Enterprise (bank / government / large org) profile
MERSAL_PRODUCTION=1
MERSAL_ENTERPRISE=1
# Set to 1 for regulated production (TLS + Postgres + dedicated update key)
# MERSAL_ENTERPRISE_STRICT=1
MERSAL_BOOTSTRAP=1
MERSAL_NO_SCHEDULER=0

MERSAL_HOST=0.0.0.0
MERSAL_PORT=8090
MERSAL_DB=data/mersal-enterprise.sqlite3

# Required — generate: openssl rand -hex 32
MERSAL_SIGNING_SECRET=CHANGE_ME_64_HEX_CHARS_MINIMUM_32_BYTES________
MERSAL_API_TOKEN=CHANGE_ME_LONG_RANDOM_API_TOKEN_FOR_AGENTS_AND_AUTOMATION
MERSAL_ADMIN_USER=admin
MERSAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

MERSAL_TLS_CERT=data/tls/mersal.crt
MERSAL_TLS_KEY=data/tls/mersal.key
MERSAL_AGENT_MTLS=1
MERSAL_AGENT_CA=data/tls/ca.crt

# Optional LDAP (pip install ldap3)
# MERSAL_LDAP_URL=ldaps://dc.bank.local:636
# MERSAL_LDAP_BASE_DN=dc=bank,dc=local
# MERSAL_LDAP_BIND_DN=cn=mersal-svc,ou=services,dc=bank,dc=local
# MERSAL_LDAP_BIND_PASSWORD=
# MERSAL_LDAP_USER_FILTER=(sAMAccountName={username})
# MERSAL_LDAP_DEFAULT_ROLE=analyst
# MERSAL_LDAP_SOC_ADMIN_GROUP=CN=SOC-Admins

# PostgreSQL (recommended for large institutions — pip install psycopg)
# MERSAL_POSTGRES_DSN=postgresql://mersal:secret@db-primary:5432/mersal

# Supply chain — separate from API token
# MERSAL_UPDATE_SIGNING_KEY=CHANGE_ME_DEDICATED_UPDATE_SIGNING_KEY

# IdP group → Mersal role (JSON)
# MERSAL_GROUP_ROLE_MAP={"SOC-Admins":"soc_admin","Auditors":"viewer"}

# SAML strict + IdP certificate (PEM)
# MERSAL_SAML_STRICT=1
# MERSAL_SAML_IDP_CERT=/etc/mersal/idp.pem

# Encrypted backups (Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# MERSAL_DB_ENCRYPTION=1
# MERSAL_BACKUP_ENCRYPTION_KEY=
# MERSAL_BACKUP_RETENTION_DAYS=30
