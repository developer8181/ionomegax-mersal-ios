# Mersal Guard v7 — Enterprise (bank / government) profile
MERSAL_PRODUCTION=1
MERSAL_ENTERPRISE=1
MERSAL_BOOTSTRAP=1
MERSAL_NO_SCHEDULER=0

MERSAL_HOST=0.0.0.0
MERSAL_PORT=8090
MERSAL_DB=data/mersal-enterprise.sqlite3

# Required — generate: openssl rand -hex 32
MERSAL_SIGNING_SECRET=CHANGE_ME_64_HEX_CHARS_MINIMUM_32_BYTES________
MERSAL_API_TOKEN=CHANGE_ME_LONG_RANDOM_API_TOKEN_FOR_AGENTS_AND_AUTOMATION
MERSAL_ADMIN_USER=admin
MERSAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

MERSAL_TLS_CERT=data/tls/mersal.crt
MERSAL_TLS_KEY=data/tls/mersal.key
MERSAL_AGENT_MTLS=1
MERSAL_AGENT_CA=data/tls/ca.crt

# Optional LDAP (pip install ldap3)
# MERSAL_LDAP_URL=ldaps://dc.bank.local:636
# MERSAL_LDAP_BASE_DN=dc=bank,dc=local
# MERSAL_LDAP_BIND_DN=cn=mersal-svc,ou=services,dc=bank,dc=local
# MERSAL_LDAP_BIND_PASSWORD=
# MERSAL_LDAP_USER_FILTER=(sAMAccountName={username})
# MERSAL_LDAP_DEFAULT_ROLE=analyst
# MERSAL_LDAP_SOC_ADMIN_GROUP=CN=SOC-Admins

# Optional PostgreSQL HA (pip install psycopg)
# MERSAL_POSTGRES_DSN=postgresql://mersal:secret@db-primary:5432/mersal
