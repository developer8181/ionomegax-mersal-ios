# Mersal v7.1 — أي مؤسسة / شركة / منظمة (ليس للإنترنت بدون أسرار)
MERSAL_PRODUCTION=1
MERSAL_BOOTSTRAP=1

MERSAL_HOST=0.0.0.0
MERSAL_PORT=8090
MERSAL_DB=data/mersal-organization.sqlite3

MERSAL_SIGNING_SECRET=REPLACE_WITH_openssl_rand_hex_32
MERSAL_API_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
MERSAL_ADMIN_USER=admin
MERSAL_ADMIN_PASSWORD=REPLACE_STRONG_PASSWORD_MIN_12

MERSAL_REQUIRE_AGENT_KEYS=1
MERSAL_TLS_CERT=data/tls/mersal.crt
MERSAL_TLS_KEY=data/tls/mersal.key

# اختياري: حصر تسجيل الدخول على شبكة الإدارة
# MERSAL_ADMIN_IP_ALLOWLIST=10.0.0.0/8,192.168.0.0/16

# بنك / حكومة — ملف إضافي:
# MERSAL_ENTERPRISE=1
